# Absolute public origin of this deployment. Supabase Auth redirect URLs
# (email confirmation, password recovery) are built from this value, so it must
# match the origin the browser actually uses — mixing `localhost` and
# `127.0.0.1` strands host-only Auth cookies on the wrong origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project BASE origin only — no path, no trailing slash.
#   correct:   https://<project-ref>.supabase.co
#   incorrect: https://<project-ref>.supabase.co/rest/v1/
# The Supabase client appends its own `/auth/v1` and `/rest/v1` paths. A value
# carrying `/rest/v1/` is normalised defensively by `getSupabaseConfig()`
# (src/lib/supabase/config.ts), but any code calling `createClient()` with the
# raw variable would build a broken URL, so configure the bare origin.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only. Never exposed to the browser and never logged.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional. The Contact page maps work without it: the embed uses Google's
# keyless `output=embed` form, so no Maps credential is provisioned for this
# project. Set this only to switch those maps over to Google's supported Embed
# API. It is a browser-safe Maps key — restrict it by HTTP referrer to the
# production host. Never put a server credential here.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
