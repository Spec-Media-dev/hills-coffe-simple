    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
